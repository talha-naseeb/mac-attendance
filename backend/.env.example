# MacqHR Backend Environment Variables Template
# Copy to `backend/.env` and fill every value. `.env` is git-ignored.
# Production startup fails fast when DATABASE_URL, JWT_SECRET or CORS_ORIGINS
# are missing, and when JWT_SECRET is shorter than 32 characters.

# Application
PORT=4000
NODE_ENV=development
# Comma-separated browser origins. "*" is rejected in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Database (PostgreSQL 15+; PostGIS is not required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/macqhr_db?schema=public"

# Isolated database for API end-to-end tests. Never point this at app data.
# Local runs load this from backend/.env; CI supplies it through the job env.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/macqhr_test?schema=public"

# JWT Authentication
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION="24h"

# Microsoft 365 Entra ID SSO (optional until Phase 7)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Anti-Spoofing & Geofence Defaults
DEFAULT_GEOFENCE_RADIUS_METERS=150
MAX_ALLOWED_GPS_ACCURACY_METERS=50
MAX_ALLOWED_NTP_DRIFT_MINUTES=5

# Saudi Labor Law Compliance
SAUDI_GOSI_EMPLOYEE_RATE=0.0975
SAUDI_GOSI_EMPLOYER_RATE=0.1175

# Sessions
JWT_ACCESS_EXPIRATION=15m
REFRESH_TOKEN_DAYS=7
SESSION_ABSOLUTE_HOURS=720
SUPER_ADMIN_SESSION_HOURS=8
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Microsoft Entra SSO stays disabled until a tenant is provisioned.
SSO_ENABLED=false
