datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  EMPLOYEE
  MANAGER
  HR_ADMIN
  SUPER_ADMIN
}

enum AttendanceStatus {
  VERIFIED
  FLAGGED
  REJECTED
  INCOMPLETE
  ON_LEAVE
}

enum WorkMode {
  OFFICE
  REMOTE
}

enum LeaveType {
  ANNUAL_VACATION
  SICK_LEAVE
  SICK_ON_FILE
  HAJJ_LEAVE
  PATERNITY_LEAVE
  MATERNITY_LEAVE
  MARRIAGE_LEAVE
  BEREAVEMENT_LEAVE
  REMOTE_WORK
  CASUAL_LEAVE
  UNPAID_LEAVE
  EMERGENCY_LEAVE
}

enum LeaveStatus {
  PENDING
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveStage {
  STAGE_1_MANAGER
  STAGE_2_HR
  COMPLETED
}

enum LeaveLedgerEntryType {
  ACCRUAL
  USAGE
  ADJUSTMENT
  CARRYOVER
  CANCELLATION_RESTORE
}

enum SessionRevokeReason {
  LOGOUT
  PASSWORD_CHANGE
  ROLE_CHANGE
  DEACTIVATED
  REFRESH_REUSE
  ADMIN_REVOKE
}

enum LocationVerdict {
  INSIDE_OFFICE
  OUTSIDE_OFFICE
  INSIDE_DECLARED_ZONE
  OUTSIDE_DECLARED_ZONE
  UNVERIFIED
}

enum RemoteRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ExceptionType {
  OUTSIDE_OFFICE_GEOFENCE
  OUTSIDE_DECLARED_ZONE
  EXCESSIVE_DISTANCE
  LATE_DECLARATION
  LOW_ACCURACY_CHECKOUT
  UNVERIFIED_CHECKOUT
}

enum ExceptionSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ExceptionStatus {
  OPEN
  ACCEPTED
  ESCALATED
}

enum EmploymentChangeType {
  TRANSFER
  PROMOTION
  SALARY
  ROLE
  MANAGER
  REMOTE_ELIGIBILITY
}

model User {
  id           String   @id @default(uuid())
  employeeId   String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole @default(EMPLOYEE)

  // Profile Identity
  firstName      String
  lastName       String
  fullName       String
  fullNameAr     String
  jobTitle       String
  titleAr        String?
  department     String
  departmentAr   String?
  phone          String?
  avatarUrl      String?
  avatarInitials String  @default("MA")
  avatarPresetId String  @default("navy")
  avatarColor    String  @default("#002C52")

  // Saudi Labor Law & Payroll
  isSaudi               Boolean @default(true)
  nationalId            String?
  iqamaNumber           String?
  iban                  String? @default("SA0380000000608010167519")
  basicSalarySar        Float   @default(10000.0)
  housingAllowanceSar   Float   @default(2500.0)
  transportAllowanceSar Float   @default(1000.0)
  isActive              Boolean @default(true)

  // Remote Work & Platform Privileges
  isRemoteAllowed    Boolean @default(false)
  remoteLocation     String? // e.g. "Lahore, Pakistan (Remote Hub)"
  isAttendanceExempt Boolean @default(false) // e.g. Executive Super Admins
  canAccessWebAdmin  Boolean @default(false) // True for SUPER_ADMIN & HR_ADMIN

  // Authentication & Session Security
  mustChangePassword  Boolean   @default(false)
  passwordChangedAt   DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  ssoSubject          String?   @unique

  // Organization Hierarchy
  managerId     String?
  manager       User?   @relation("TeamHierarchy", fields: [managerId], references: [id])
  subordinates  User[]  @relation("TeamHierarchy")
  directReports User[]  @relation("DirectReports")
  reportsToId   String?
  reportsTo     User?   @relation("DirectReports", fields: [reportsToId], references: [id])

  // Remote Eligibility Grant Audit
  remoteGrantedById  String?
  remoteGrantedBy    User?     @relation("RemoteGrantor", fields: [remoteGrantedById], references: [id], onDelete: SetNull)
  remoteGrantedUsers User[]    @relation("RemoteGrantor")
  remoteGrantedAt    DateTime?

  // Branch Assignment
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // Relations
  attendance         AttendanceRecord[]
  attendanceDays     AttendanceDay[]
  remoteRequests     RemoteWorkRequest[]    @relation("EmployeeRemoteRequests")
  decidedRemoteReqs  RemoteWorkRequest[]    @relation("RemoteRequestDecisions")
  savedLocations     SavedLocation[]
  reviewedExceptions AttendanceException[]  @relation("ExceptionReviewer")
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]         @relation("EmployeeRequests")
  decidedLeaves         LeaveRequest[]         @relation("DecidedByManager")
  reviewedLeavesManager LeaveRequest[]         @relation("LeaveManagerReviewer")
  reviewedLeavesHr      LeaveRequest[]         @relation("LeaveHrReviewer")
  leaveLedgerEntries    LeaveBalanceLedger[]   @relation("UserLeaveLedgers")
  createdLedgerEntries  LeaveBalanceLedger[]   @relation("LedgerCreatedBy")
  offlinePunches     OfflinePunchQueue[]
  auditLogs          AuditLog[]
  sessions           AuthSession[]
  employeeChanges    EmploymentChange[]     @relation("EmployeeChanges")
  changesMade        EmploymentChange[]     @relation("EmploymentChangeActor")
  salaryRecords       EmployeeSalaryRecord[]
  notifications       Notification[]         @relation("UserNotifications")
  deviceTokens        DeviceToken[]          @relation("UserDeviceTokens")
  payslips            Payslip[]
  preparedPayrollRuns PayrollRun[]           @relation("PayrollPreparedBy")
  reviewedPayrollRuns PayrollRun[]           @relation("PayrollReviewedBy")
  lockedPayrollRuns   PayrollRun[]           @relation("PayrollLockedBy")
  payrollAdjustments  PayrollAdjustment[]
  reimbursementClaims ReimbursementClaim[]   @relation("EmployeeClaims")
  reviewedClaimsMgr   ReimbursementClaim[]   @relation("ClaimManagerReviewer")
  reviewedClaimsHr    ReimbursementClaim[]   @relation("ClaimHrReviewer")
  documents           EmployeeDocument[]     @relation("EmployeeDocuments")
  verifiedDocuments   EmployeeDocument[]     @relation("DocumentVerifier")
  uploadedDocuments   EmployeeDocument[]     @relation("DocumentUploader")
  memberships         Membership[]           @relation("UserMemberships")
  authIdentities      AuthIdentity[]         @relation("UserAuthIdentities")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([managerId])
  @@index([branchId])
}

model Branch {
  id                   String     @id @default(uuid())
  workspaceId          String?
  workspace            Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  name                 String     @unique
  nameAr               String
  code                 String?    @unique
  city                 String
  cityAr               String
  address              String?
  latitude             Float
  longitude            Float
  geofenceRadiusMeters Float      @default(150.0)
  radiusMeters         Float      @default(150.0)
  wifiBssids           String[]   @default([])
  bleBeacons           String[]   @default([])
  isActive             Boolean    @default(true)

  users      User[]
  attendance AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model AttendanceRecord {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  dayId String?
  day   AttendanceDay? @relation(fields: [dayId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  type         String   @default("CHECK_IN") // CHECK_IN | CHECK_OUT | BREAK_START | BREAK_END | RELOCATION
  timestamp    DateTime @default(now())
  dateIso      String? // e.g. "2026-10-24"
  clockInTime  String? // e.g. "09:02 AM"
  clockOutTime String? // e.g. "05:14 PM"

  status   AttendanceStatus @default(VERIFIED)
  workMode WorkMode         @default(OFFICE)

  // GPS & Telemetry verification
  latitude          Float
  longitude         Float
  accuracyMeters    Float
  distanceToBranch  Float?
  isMockLocation    Boolean @default(false)
  isDeviceRooted    Boolean @default(false)
  wifiBssid         String?
  biometricVerified Boolean @default(true)

  // Location event metadata
  clientEventId      String?
  reasonCode         String?
  verdict            LocationVerdict?
  distanceToDeclared Float?
  source             String?
  capturedAt         DateTime?
  lateSubmission     Boolean          @default(false)

  // Offline Punch tracking
  wasOfflineSynced Boolean @default(false)
  offlineSignature String?
  notes            String?

  // Anti-Spoofing Security Flags (Array of triggered rules)
  securityFlags String[] @default([])

  // Duration Metrics
  workingMinutes Int @default(0)
  breakMinutes   Int @default(0)

  exceptions AttendanceException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([dayId])
}

model AttendanceDay {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateIso         String // YYYY-MM-DD in local timezone
  mode            WorkMode           @default(OFFICE)
  remoteRequestId String?
  remoteRequest   RemoteWorkRequest? @relation(fields: [remoteRequestId], references: [id], onDelete: SetNull)

  declaredLabel        String?
  declaredLatitude     Float?
  declaredLongitude    Float?
  declaredRadiusMeters Float?    @default(500)
  declaredSource       String? // DECLARED | CHECK_IN_LOCATION | SAVED_LOCATION
  declaredAt           DateTime?

  status             AttendanceStatus @default(INCOMPLETE)
  firstCheckInAt     DateTime?
  lastCheckOutAt     DateTime?
  workingMinutes     Int              @default(0)
  breakMinutes       Int              @default(0)
  openExceptionCount Int              @default(0)

  events     AttendanceRecord[]
  exceptions AttendanceException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dateIso])
  @@index([workspaceId, dateIso])
  @@index([dateIso])
  @@index([status])
}

model RemoteWorkRequest {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("EmployeeRemoteRequests", fields: [userId], references: [id], onDelete: Cascade)

  startDateIso String // YYYY-MM-DD, inclusive
  endDateIso   String // YYYY-MM-DD, inclusive
  reason       String
  status       RemoteRequestStatus @default(PENDING)

  decidedById     String?
  decidedBy       User?     @relation("RemoteRequestDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  rejectionReason String?

  days      AttendanceDay[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, status])
  @@index([status, startDateIso])
}

model SavedLocation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label        String
  latitude     Float
  longitude    Float
  radiusMeters Float   @default(500)
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AttendanceException {
  id       String            @id @default(uuid())
  dayId    String
  day      AttendanceDay     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  recordId String?
  record   AttendanceRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  type        ExceptionType
  severity    ExceptionSeverity @default(MEDIUM)
  status      ExceptionStatus   @default(OPEN)
  detailsJson Json?

  reviewedById String?
  reviewedBy   User?     @relation("ExceptionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayId])
  @@index([status])
}

model LeaveBalance {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  leaveType     String
  totalDays     Float
  usedDays      Float    @default(0)
  pendingDays   Float    @default(0)
  remainingDays Float    @default(30)
  year          Int      @default(2026)

  ledgerEntries LeaveBalanceLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, leaveType, year])
  @@index([workspaceId, userId])
  @@index([userId, year])
}

model LeaveRequest {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  userId      String
  user        User       @relation("EmployeeRequests", fields: [userId], references: [id], onDelete: Cascade)

  type          String   @default("ANNUAL")
  startDate     DateTime
  endDate       DateTime
  daysCount     Float    @default(1.0)
  isHalfDay     Boolean  @default(false)
  halfDayPeriod String?  // MORNING, AFTERNOON
  reason        String?
  attachmentUrl String?

  status             String     @default("PENDING_MANAGER") // PENDING_MANAGER, PENDING_HR, APPROVED, REJECTED, CANCELLED
  stage              LeaveStage @default(STAGE_1_MANAGER)
  routedDirectlyToHr Boolean    @default(false)

  // Stage 1: Line Manager Review
  managerReviewedById String?
  managerReviewedBy   User?     @relation("LeaveManagerReviewer", fields: [managerReviewedById], references: [id], onDelete: SetNull)
  managerReviewedAt   DateTime?
  managerComments     String?

  // Stage 2: HR Admin Review
  hrReviewedById String?
  hrReviewedBy   User?     @relation("LeaveHrReviewer", fields: [hrReviewedById], references: [id], onDelete: SetNull)
  hrReviewedAt   DateTime?
  hrComments     String?

  // Legacy fields
  reviewedBy      String?
  reviewedAt      DateTime?
  decidedById     String?
  decidedBy       User?     @relation("DecidedByManager", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  rejectionReason String?

  // Cancellation
  cancelledAt        DateTime?
  cancellationReason String?

  // MS 365 Cloud Sync Identifiers
  teamsAdaptiveCardMessageId String?
  outlookCalendarEventId     String?

  ledgerEntries LeaveBalanceLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([stage])
  @@index([startDate, endDate])
}

model LeaveBalanceLedger {
  id        String               @id @default(uuid())
  balanceId String
  balance   LeaveBalance         @relation(fields: [balanceId], references: [id], onDelete: Cascade)
  userId    String
  user      User                 @relation("UserLeaveLedgers", fields: [userId], references: [id], onDelete: Cascade)

  leaveType     String
  entryType     LeaveLedgerEntryType
  amount        Float
  balanceBefore Float
  balanceAfter  Float

  requestId   String?
  request     LeaveRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  reason      String?
  createdById String?
  createdBy   User?         @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, leaveType])
  @@index([balanceId])
}

model CompanyHoliday {
  id        String   @id @default(uuid())
  name      String
  nameAr    String?
  dateIso   String   @unique // YYYY-MM-DD
  isOffDay  Boolean  @default(true)
  country   String   @default("SA")
  createdAt DateTime @default(now())

  @@index([dateIso])
}

model OfflinePunchQueue {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rawTelemetryJson Json
  fnv1aSignature   String
  isTampered       Boolean   @default(false)
  isSynced         Boolean   @default(false)
  syncedAt         DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isSynced])
}

model AuditLog {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actorUserId String?
  actorUser   User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  action      String // e.g. "GEOFENCE_BREACH_DETECTED", "MOCK_LOCATION_BLOCKED"
  resource    String // e.g. "AttendanceRecord", "LeaveRequest"
  detailsJson Json?
  ipAddress   String?

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([actorUserId])
  @@index([action])
}

model AuthSession {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId  String?
  workspace    Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  familyId         String
  refreshTokenHash String       @unique
  replacedById     String?      @unique
  replacedBy       AuthSession? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces         AuthSession? @relation("SessionRotation")

  absoluteExpiresAt DateTime
  refreshExpiresAt  DateTime
  revokedAt         DateTime?
  revokeReason      SessionRevokeReason?
  ipAddress         String?
  userAgent         String?
  lastUsedAt        DateTime             @default(now())

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([workspaceId, userId])
  @@index([familyId])
}

model EmploymentChange {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("EmployeeChanges", fields: [userId], references: [id], onDelete: Cascade)

  type          EmploymentChangeType
  effectiveDate String // YYYY-MM-DD
  reason        String
  beforeJson    Json
  afterJson     Json

  actorUserId String?
  actor       User?   @relation("EmploymentChangeActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  salaryRecord EmployeeSalaryRecord?
  createdAt    DateTime              @default(now())

  @@index([userId, effectiveDate])
  @@index([type, effectiveDate])
}

model EmployeeSalaryRecord {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  basicSalarySar        Float
  housingAllowanceSar   Float
  transportAllowanceSar Float
  effectiveFrom         String // YYYY-MM-DD

  changeId String?           @unique
  change   EmploymentChange? @relation(fields: [changeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, effectiveFrom])
}

enum NotificationType {
  LEAVE_REQUEST
  LEAVE_STAGE_1_APPROVED
  LEAVE_APPROVAL
  LEAVE_REJECTION
  LEAVE_CANCELLED
  ATTENDANCE_ALERT
  SYSTEM
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  type      NotificationType @default(SYSTEM)
  title     String
  titleAr   String?
  body      String
  bodyAr    String?
  read      Boolean          @default(false)
  readAt    DateTime?
  dataJson  Json?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation("UserDeviceTokens", fields: [userId], references: [id], onDelete: Cascade)
  token     String         @unique
  platform  DevicePlatform @default(IOS)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
}

enum PayrollRunStatus {
  PREPARED
  REVIEWED
  LOCKED
}

model PayrollRun {
  id          String           @id @default(uuid())
  workspaceId String?
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  period      String           @unique // YYYY-MM
  status      PayrollRunStatus @default(PREPARED)

  currency                String @default("SAR")
  totalEmployees          Int    @default(0)
  totalBasicHalalas       Int    @default(0)
  totalHousingHalalas     Int    @default(0)
  totalTransportHalalas   Int    @default(0)
  totalOvertimeHalalas    Int    @default(0)
  totalAdjustmentsHalalas Int    @default(0)
  totalGrossHalalas       Int    @default(0)
  totalUnpaidLeaveHalalas Int    @default(0)
  totalGosiEmployeeHalalas Int   @default(0)
  totalGosiEmployerHalalas Int   @default(0)
  totalNetHalalas         Int    @default(0)

  gosiPolicyJson Json?
  notes          String?

  preparedById String?
  preparedBy   User?     @relation("PayrollPreparedBy", fields: [preparedById], references: [id], onDelete: SetNull)
  preparedAt   DateTime  @default(now())

  reviewedById String?
  reviewedBy   User?     @relation("PayrollReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  lockedById String?
  lockedBy   User?     @relation("PayrollLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  lockedAt   DateTime?

  payslips            Payslip[]
  adjustments         PayrollAdjustment[]
  reimbursementClaims ReimbursementClaim[]
  wpsExports          PayrollWpsExport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([status])
}

model Payslip {
  id     String     @id @default(uuid())
  runId  String
  run    PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  period String // YYYY-MM

  employeeIdSnapshot        String
  employeeNameSnapshot      String
  departmentSnapshot        String
  jobTitleSnapshot          String
  isSaudiSnapshot           Boolean
  nationalOrIqamaIdSnapshot String?
  ibanSnapshot              String?

  basicSalaryHalalas        Int
  housingAllowanceHalalas   Int
  transportAllowanceHalalas Int
  overtimeHalalas           Int   @default(0)
  adjustmentsHalalas        Int   @default(0)
  grossSalaryHalalas        Int
  unpaidLeaveDays           Float @default(0)
  unpaidLeaveDeductionHalalas Int @default(0)
  gosiContributoryHalalas   Int
  gosiEmployeeHalalas       Int
  gosiEmployerHalalas       Int
  totalDeductionsHalalas    Int
  netSalaryHalalas          Int

  breakdownJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, userId])
  @@index([userId, period])
}

model PayrollAdjustment {
  id     String      @id @default(uuid())
  runId  String?
  run    PayrollRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  period String // YYYY-MM

  amountHalalas Int
  overtimeHours Float   @default(0)
  reason        String
  createdById   String?

  createdAt DateTime @default(now())

  @@index([userId, period])
}

model PayrollWpsExport {
  id              String     @id @default(uuid())
  runId           String
  run             PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  period          String
  rowCount        Int
  totalNetHalalas Int
  csvSha256       String
  exportedById    String?
  createdAt       DateTime   @default(now())

  @@index([runId])
}

enum IntegrationProvider {
  TEAMS
  OUTLOOK
  ENTRA_SSO
}

enum IntegrationEventStatus {
  PENDING
  DELIVERED
  FAILED
  CANCELLED
}

model IntegrationConfig {
  id                String              @id @default(uuid())
  provider          IntegrationProvider @unique
  enabled           Boolean             @default(true)
  webhookUrl        String?
  tenantId          String?
  simulateFailure   Boolean             @default(false)
  lastSuccessAt     DateTime?
  lastFailureAt     DateTime?
  lastErrorMessage  String?
  updatedAt         DateTime            @updatedAt
}

model IntegrationOutboxEvent {
  id                String                 @id @default(uuid())
  idempotencyKey    String                 @unique
  provider          IntegrationProvider
  eventType         String
  resourceId        String
  payloadJson       Json
  status            IntegrationEventStatus @default(PENDING)
  attempts          Int                    @default(0)
  externalMessageId String?
  lastError         String?
  deliveredAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([provider, status])
  @@index([resourceId])
}

enum ClaimCategory {
  MEDICAL
  INSURANCE
  PETROL
  WIFI
}

enum ClaimStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

enum ClaimStage {
  STAGE_1_MANAGER
  STAGE_2_HR
  COMPLETED
}

model ReimbursementPolicy {
  id                String        @id @default(uuid())
  category          ClaimCategory @unique
  monthlyCapHalalas Int
  annualCapHalalas  Int
  requiresReceipt   Boolean       @default(true)
  allowDirectToHr   Boolean       @default(false)
  isActive          Boolean       @default(true)
  updatedAt         DateTime      @updatedAt
}

model ReimbursementClaim {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  userId      String
  user        User       @relation("EmployeeClaims", fields: [userId], references: [id], onDelete: Cascade)

  category         ClaimCategory
  period           String // YYYY-MM payroll period
  amountHalalas    Int
  currency         String        @default("SAR")
  description      String
  receiptUrl       String
  receiptFileName  String?
  exceedsCap       Boolean       @default(false)
  isPrivateMedical Boolean       @default(false)

  status             ClaimStatus @default(PENDING_MANAGER)
  stage              ClaimStage  @default(STAGE_1_MANAGER)
  routedDirectlyToHr Boolean     @default(false)

  // Stage 1: Line Manager Review
  managerReviewedById String?
  managerReviewedBy   User?     @relation("ClaimManagerReviewer", fields: [managerReviewedById], references: [id], onDelete: SetNull)
  managerReviewedAt   DateTime?
  managerComments     String?

  // Stage 2: HR Admin Review
  hrReviewedById String?
  hrReviewedBy   User?     @relation("ClaimHrReviewer", fields: [hrReviewedById], references: [id], onDelete: SetNull)
  hrReviewedAt   DateTime?
  hrComments     String?

  // Payroll Run link (once linked to a LOCKED run, claim is immutable)
  payrollRunId String?
  payrollRun   PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([userId, period])
  @@index([status, stage])
  @@index([payrollRunId])
}

enum DocumentType {
  NATIONAL_ID_IQAMA
  PASSPORT
  MEDICAL_INSURANCE
  EMPLOYMENT_CONTRACT
}

enum DocumentVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  EXPIRED
}

model EmployeeDocument {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  userId      String
  user        User       @relation("EmployeeDocuments", fields: [userId], references: [id], onDelete: Cascade)

  documentType   DocumentType
  title          String
  documentNumber String?
  fileUrl        String
  fileName       String?
  issuedDateIso  String? // YYYY-MM-DD
  expiryDateIso  String? // YYYY-MM-DD
  status         DocumentVerificationStatus @default(PENDING_VERIFICATION)

  verifiedById     String?
  verifiedBy       User?     @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt       DateTime?
  verificationNote String?

  uploadedById String?
  uploadedBy   User?   @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([userId, documentType])
  @@index([status])
  @@index([expiryDateIso])
}

// ============================================================================
// Phase 13: Multi-Tenant B2B SaaS Workspaces, Memberships, SSO & Subscriptions
// (Account Model D1-D5)
// ============================================================================

enum WorkspaceType {
  PERSONAL
  BUSINESS
}

enum WorkspacePlanCode {
  INDIVIDUAL_FREE
  INDIVIDUAL_PRO
  BUSINESS_STARTER
  BUSINESS_GROWTH
  ENTERPRISE
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum AuthProviderType {
  LOCAL
  GOOGLE
  MICROSOFT
  APPLE
}

enum SsoProviderType {
  GOOGLE
  MICROSOFT
}

enum SsoConnectionStatus {
  NOT_CONFIGURED
  DRAFT
  VERIFIED
  ERROR
}

enum LeaveApprovalPolicy {
  MANAGER_ONLY
  MANAGER_THEN_HR
}

model Workspace {
  id                  String              @id @default(uuid())
  type                WorkspaceType       @default(BUSINESS)
  name                String
  nameAr              String?
  slug                String              @unique
  country             String              @default("SA")
  timezone            String              @default("Asia/Riyadh")
  currency            String              @default("SAR")
  logoUrl             String?
  planCode            WorkspacePlanCode   @default(BUSINESS_GROWTH)
  status              WorkspaceStatus     @default(ACTIVE)
  leaveApprovalPolicy LeaveApprovalPolicy @default(MANAGER_THEN_HR)
  ownerMembershipId   String?

  memberships         Membership[]
  ssoConnection       SsoConnection?
  groupMappings       SsoGroupMapping[]
  invites             Invite[]
  subscription        Subscription?
  branches            Branch[]
  attendanceRecords   AttendanceRecord[]
  attendanceDays      AttendanceDay[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  auditLogs           AuditLog[]
  authSessions        AuthSession[]
  payrollRuns         PayrollRun[]
  reimbursementClaims ReimbursementClaim[]
  employeeDocuments   EmployeeDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([planCode])
}

model Membership {
  id          String           @id @default(uuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role        MembershipRole   @default(EMPLOYEE)
  status      MembershipStatus @default(ACTIVE)

  employeeId          String?
  jobTitle            String?
  titleAr             String?
  department          String?
  departmentAr        String?
  branchId            String?
  basicSalarySar      Float   @default(10000.0)
  housingAllowanceSar Float   @default(2500.0)
  transportAllowanceSar Float @default(1000.0)
  isRemoteAllowed     Boolean @default(false)
  sessionVersion      Int     @default(1)
  managedBySsoGroup   String? // null if manual or overridden

  reportsToMembershipId String?
  reportsTo             Membership?  @relation("MembershipHierarchy", fields: [reportsToMembershipId], references: [id], onDelete: SetNull)
  directReports         Membership[] @relation("MembershipHierarchy")

  sentInvites  Invite[]      @relation("InviteSender")
  authSessions AuthSession[]

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@unique([workspaceId, employeeId])
  @@index([workspaceId, role])
  @@index([workspaceId, status])
  @@index([userId])
}

model AuthIdentity {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation("UserAuthIdentities", fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProviderType @default(LOCAL)
  providerAccountId String
  emailAtProvider   String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model SsoConnection {
  id                String              @id @default(uuid())
  workspaceId       String              @unique
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider          SsoProviderType     @default(MICROSOFT)
  domain            String?
  tenantId          String?
  clientId          String?
  clientSecretMasked String?
  enforced          Boolean             @default(false)
  autoProvision     Boolean             @default(false)
  allowHrGroupMapping Boolean           @default(false)
  defaultRole       MembershipRole      @default(EMPLOYEE)
  status            SsoConnectionStatus @default(DRAFT)
  lastSyncedAt      DateTime?
  lastError         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model SsoGroupMapping {
  id                String         @id @default(uuid())
  workspaceId       String
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerGroupId   String
  providerGroupName String
  role              MembershipRole @default(EMPLOYEE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([workspaceId, providerGroupId])
  @@index([workspaceId])
}

model Invite {
  id                    String         @id @default(uuid())
  workspaceId           String
  workspace             Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email                 String
  role                  MembershipRole @default(EMPLOYEE)
  jobTitle              String?
  department            String?
  reportsToMembershipId String?
  tokenHash             String         @unique
  expiresAt             DateTime
  invitedByMembershipId String?
  invitedBy             Membership?    @relation("InviteSender", fields: [invitedByMembershipId], references: [id], onDelete: SetNull)
  acceptedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime       @default(now())

  @@index([workspaceId, email])
  @@index([workspaceId, acceptedAt, revokedAt])
}

model Subscription {
  id                 String    @id @default(uuid())
  workspaceId        String    @unique
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider           String    @default("STRIPE")
  externalCustomerId String?
  seatsPurchased     Int       @default(50)
  status             String    @default("ACTIVE")
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}



