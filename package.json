{
  "name": "macqhr-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node .test-dist/__tests__/macqhr.test.js && rm -rf .test-dist",
    "verify": "npm run typecheck && npm test",
    "backend:dev": "cd backend && npm run start:dev",
    "admin:dev": "cd web-admin && npm run dev",
    "admin:build": "cd web-admin && npm run build",
    "hooks:install": "sh scripts/install-git-hooks.sh",
    "verify:all": "npm run verify && (cd backend && npm run typecheck && npm test && npm run build) && (cd web-admin && npm run build)"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "expo": "^57.0.30",
    "expo-location": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "libphonenumber-js": "^1.13.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
