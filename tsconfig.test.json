{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": ".test-dist"
  },
  "include": [
    "src/services/**/*.ts",
    "src/theme/**/*.ts",
    "src/i18n/**/*.ts",
    "src/__tests__/**/*.ts"
  ]
}
