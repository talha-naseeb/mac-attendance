#!/bin/sh
# MacqHR pre-push gate (RULES.md Section 0, PRD M1.6).
#
# Blocks every push unless:
# 1. `npm run verify:all` passes for mobile, backend and admin.
# 2. A signed gate in docs/qa/gates records the exact pushed commit as APPROVED.
#
# A commit that only adds or edits docs/qa/gates is treated as gate metadata:
# it is checked against its parent commit so signing a gate does not invalidate
# the approval it records.

set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

echo "[MacqHR] Running npm run verify:all (mobile + backend + admin)..."
if ! npm run verify:all; then
  echo "[MacqHR] BLOCKED: verify:all failed. Fix types, tests or the admin build before pushing."
  exit 1
fi

ZERO=0000000000000000000000000000000000000000

is_approved() {
  target=$1
  for gate in "$ROOT"/docs/qa/gates/*.md; do
    [ -f "$gate" ] || continue
    if grep -q "^- \*\*Commit\*\*: ${target}$" "$gate" &&
       grep -q "^- \*\*Decision\*\*: APPROVED" "$gate"; then
      return 0
    fi
  done
  return 1
}

blocked=0
checked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue

  # Branch/tag deletion: nothing to verify.
  if [ "$local_sha" = "$ZERO" ]; then
    continue
  fi

  commit=$(git rev-parse "${local_sha}^{commit}" 2>/dev/null || echo "$local_sha")
  checked=$((checked + 1))

  changed=$(git diff-tree --no-commit-id --name-only -r "$commit" 2>/dev/null | grep -v '^docs/qa/gates/' || true)
  if [ -z "$changed" ]; then
    parent=$(git rev-parse "${commit}^" 2>/dev/null || true)
    if [ -n "$parent" ]; then
      commit=$parent
    fi
  fi

  if is_approved "$commit"; then
    echo "[MacqHR] Gate OK for $commit"
  else
    echo "[MacqHR] BLOCKED: no APPROVED gate for $commit"
    blocked=1
  fi
done

if [ "$checked" -eq 0 ]; then
  echo "[MacqHR] No refs to check. Run verify:all only."
  exit 0
fi

if [ "$blocked" -ne 0 ]; then
  echo ""
  echo "[MacqHR] Push blocked by the manual approval gate."
  echo "  1. Execute the phase checklist from docs/prd/test-plan.md."
  echo "  2. Copy docs/qa/gates/TEMPLATE.md to docs/qa/gates/phase-<N>.md."
  echo "  3. Record the full commit SHA, decision APPROVED and your signature."
  echo "  4. Commit the gate, then push. Never use --no-verify."
  exit 1
fi

echo "[MacqHR] Automated verification and manual gate passed. Proceeding with push."
exit 0
