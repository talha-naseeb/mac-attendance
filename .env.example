# ============================================================================
# MacqHR (React Native / Expo) — Required API Keys & Client IDs Template
# Copy or save values into `.env` (which is git-ignored)
# ============================================================================

# 1. Google Maps Platform (react-native-maps & Geocoding)
# Enable in Google Cloud Console:
#   - Maps SDK for Android
#   - Maps SDK for iOS
#   - Maps JavaScript API
#   - Geocoding API
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# 2. Microsoft 365 / Entra ID (Azure AD SSO, Teams Presence & Outlook Calendar)
# Obtain from Microsoft Entra Admin Center -> App Registrations
EXPO_PUBLIC_MS_ENTRA_TENANT_ID=
EXPO_PUBLIC_MS_ENTRA_CLIENT_ID=
EXPO_PUBLIC_MS_ENTRA_REDIRECT_URI=macqhr://auth

# 3. Backend API / Database (REST API or Supabase PostgreSQL)
EXPO_PUBLIC_API_BASE_URL=https://api.macquires.sa/v1
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
